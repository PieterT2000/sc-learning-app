GROQ_API_KEY=your_groq_api_key_here

# Optional: Microsoft Azure AI Speech for a higher-quality British TTS voice.
# Leave blank and the app falls back to the browser's built-in speech synthesis.
# Free tier (F0): 500,000 characters/month, no expiry. In the Azure portal,
# create a "Speech" resource, then copy one of its keys and its region.
AZURE_SPEECH_KEY=
# Set EITHER the region token OR the full endpoint URL (from "Keys and Endpoint").
AZURE_SPEECH_REGION=uksouth
AZURE_SPEECH_ENDPOINT=
# Optional voice override. Default is en-GB-SoniaNeural (female);
# en-GB-RyanNeural is the male equivalent.
AZURE_SPEECH_VOICE=
# Optional speaking-rate boost in percentage points (default 18). Higher = faster.
AZURE_SPEECH_RATE_BOOST=
